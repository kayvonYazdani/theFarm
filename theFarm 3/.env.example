# Copy to theFarm 3/.env. Never commit populated credentials.
# Gemini stages (required when AI_ENABLED=True)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# YouTube discovery only; uploading uses separate OAuth files in ../tokens/
YOUTUBE_API_KEY=replace_with_your_youtube_data_api_key

# Twitch discovery only
TWITCH_CLIENT_ID=replace_with_your_twitch_client_id
TWITCH_CLIENT_SECRET=replace_with_your_twitch_client_secret
